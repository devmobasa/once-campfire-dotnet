#!/usr/bin/env dotnet
// Builds the long-room seed: the default seed with about 236,000 messages in its busy
// room, posted through the app's HTTP endpoint the way the Rust port's room got them for its published long-room
// numbers (once-campfire-rust 9e2a110, bench/results/room-index-20260927: the POST benchmark of header-csrf-20260927
// left 235,767 messages in one room, and the room page and messages page were measured on that database).
//
//   bench/long-room-seed                            the reference (Rails) posts until the busy room holds 235,767
//   bench/long-room-seed --messages 2000 --name long-room-smoke    a small one, to try the suite
//   DOTNET_NATIVE_SECURITY=0 bench/long-room-seed --writer dotnet-aot   prepared legacy writer only
//   bench/long-room-seed --force                    replace an existing seed (the old one is renamed, not deleted)
//
// It runs `SUITES=fill bench/run --apps <writer>` on a fresh copy of the source seed (the writer's image, CPUs, ports and
// container naming come from bench/run's environment, as for a benchmark), which posts `bench write N` messages with
// `bench/loadgen http --post-room` at --conc connections and stops the app cleanly. Then it checkpoints the WAL, checks
// the database, and writes $PARITY_SEED_DIR/<name>/ with labels.json extended by long_room.room, long_room.messages,
// long_room.before (the message 20 before the newest, as Rust's messages page used ?before=235747 of 235,767) and
// long-room.json (how the seed was made, and the writer image's identity). The seed's push and webhook endpoints are
// neutered, as bench/run neuters every copy it serves.
// Takes about 16 minutes with the reference writing on 4 CPUs (about 250 posts/s), 5 with .NET.
// Exit codes: 0 built, 1 failed, 2 bad usage.
#:property RestorePackagesWithLockFile=false
#:include ../eng/lib/Repository.cs
#:include ../eng/lib/Commands.cs
#:include ../eng/lib/ArgumentReader.cs

using System.Globalization;
using System.Security.Cryptography;
using System.Text.Encodings.Web;
using System.Text.Json;
using System.Text.Json.Nodes;

return await LongRoomSeed.RunAsync( args ).ConfigureAwait( false );

internal static class LongRoomSeed
{
    /// <summary>The Rust room's size (room-index-20260927/report.md).</summary>
    private const int RustRoomMessages = 235_767;

    /// <summary>How far back from the newest message the messages page starts: Rust's ?before=235747 of 235,767.</summary>
    private const int BeforeOffset = 20;

    private const string RoomLabelKey = "long_room.room";
    private const string MessagesLabelKey = "long_room.messages";
    private const string BeforeLabelKey = "long_room.before";
    private const string WriterLabelKey = "long_room.writer";

    public static async Task<int> RunAsync( string[] args )
    {
        var options = SeedOptions.Parse( args );
        if ( options is null )
        {
            return 2;
        }

        var repo = Repository.Root;
        var seeds = Repository.SeedDirectory;
        var source = Path.Combine( seeds, options.Source );
        var sourceDb = Path.Combine( source, "db", "production.sqlite3" );
        var target = Path.Combine( seeds, options.Name );
        if ( !File.Exists( sourceDb ) )
        {
            await Console.Error.WriteLineAsync( $"bench/long-room-seed: no seed at {source} (parity/bin/seed build {options.Source})" ).ConfigureAwait( false );
            return 2;
        }

        if ( Directory.Exists( target ) && !options.Force )
        {
            await Console.Error.WriteLineAsync( $"bench/long-room-seed: {target} exists; --force replaces it" ).ConfigureAwait( false );
            return 2;
        }

        var labels = JsonNode.Parse( await File.ReadAllTextAsync( Path.Combine( source, "labels.json" ) ).ConfigureAwait( false ) )!.AsObject( );
        var room = labels[options.RoomLabel]!.GetValue<long>( );
        var existing = await SqlNumberAsync( sourceDb, $"SELECT count(*) FROM messages WHERE room_id = {room};", readOnly: true ).ConfigureAwait( false );
        var toPost = options.Messages - existing;
        if ( toPost <= 0 )
        {
            await Console.Error.WriteLineAsync( $"bench/long-room-seed: room {room} already holds {existing} messages" ).ConfigureAwait( false );
            return 2;
        }

        var work = Path.Combine( seeds, $".{options.Name}.building" );
        if ( Directory.Exists( work ) )
        {
            Directory.Delete( work, recursive: true );
        }

        var filled = Path.Combine( work, "seed" );
        var results = Path.Combine( work, "run" );
        Directory.CreateDirectory( work );
        Console.WriteLine( $"bench/long-room-seed: {options.Writer} posts {toPost:N0} messages into room {room} "
            + $"({existing} there already), {options.Connections} connections" );

        var environment = new Dictionary<string, string>
        {
            ["SUITES"] = "fill",
            ["SEED_NAME"] = options.Source,
            ["ROOM_LABEL"] = options.RoomLabel,
            ["FILL_MESSAGES"] = toPost.ToString( CultureInfo.InvariantCulture ),
            ["FILL_OUT"] = filled,
            ["FILL_CONC"] = options.Connections.ToString( CultureInfo.InvariantCulture ),
            // Writing a seed is not a measurement: no wait for a quiet machine unless the caller asks for one.
            ["LOAD_MAX"] = Environment.GetEnvironmentVariable( "LOAD_MAX" ) ?? "1000",
        };
        var started = DateTimeOffset.UtcNow;
        var exit = await Commands.RunAsync(
            Path.Combine( repo, "bench", "run" ),
            ["--apps", options.Writer, "--reps", "1", "--out", results],
            repo,
            environment ).ConfigureAwait( false );
        if ( exit != 0 || !File.Exists( Path.Combine( filled, "db", "production.sqlite3" ) ) )
        {
            await Console.Error.WriteLineAsync( $"bench/long-room-seed: the fill failed (bench/run exit code {exit}); its output is in {work}" )
                .ConfigureAwait( false );
            return 1;
        }

        var db = Path.Combine( filled, "db", "production.sqlite3" );
        var check = await SqlAsync( db, "PRAGMA wal_checkpoint(TRUNCATE); PRAGMA quick_check;" ).ConfigureAwait( false );
        if ( !check.EndsWith( "ok", StringComparison.Ordinal ) )
        {
            await Console.Error.WriteLineAsync( $"bench/long-room-seed: the filled database fails its check: {check}" ).ConfigureAwait( false );
            return 1;
        }

        var inRoom = await SqlNumberAsync( db, $"SELECT count(*) FROM messages WHERE room_id = {room};" ).ConfigureAwait( false );
        var before = await SqlNumberAsync(
                db,
                $"SELECT id FROM messages WHERE room_id = {room} ORDER BY created_at DESC, id DESC LIMIT 1 OFFSET {BeforeOffset};" )
            .ConfigureAwait( false );

        labels[RoomLabelKey] = room;
        labels[MessagesLabelKey] = inRoom;
        labels[BeforeLabelKey] = before;
        labels[WriterLabelKey] = options.Writer;
        labels["long_room.native_security"] = false;
        // Readable files: labels hold signed tokens (`=`, `+`), which the default encoder would escape.
        var indented = new JsonSerializerOptions { WriteIndented = true, Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
        await File.WriteAllTextAsync( Path.Combine( filled, "labels.json" ), labels.ToJsonString( indented ) ).ConfigureAwait( false );

        var fill = JsonNode.Parse( await File.ReadAllTextAsync( Path.Combine( results, "fill.json" ) ).ConfigureAwait( false ) );
        var identity = await Commands.CaptureAsync(
                "docker",
                ["image", "inspect", "-f", "{{.Id}} {{index .Config.Labels \"org.opencontainers.image.revision\"}}", WriterImage( options.Writer )] )
            .ConfigureAwait( false );
        var metadata = new JsonObject
        {
            ["created"] = started.ToString( "O", CultureInfo.InvariantCulture ),
            ["method"] = "the source seed, then bench/loadgen http --post-room (\"bench write N\" bodies) through the writer's front server, "
                + "as the Rust port's POST benchmark filled its room for room-index-20260927",
            ["source_seed"] = options.Source,
            ["source_db_sha256"] = Convert.ToHexStringLower( SHA256.HashData( await File.ReadAllBytesAsync( sourceDb ).ConfigureAwait( false ) ) ),
            ["room"] = room,
            ["messages_requested"] = options.Messages,
            ["messages_in_room"] = inRoom,
            ["before"] = before,
            ["writer"] = options.Writer,
            ["writer_image"] = identity.Trimmed,
            ["fill"] = fill?["fill"]?.DeepClone( ),
            ["seconds"] = Math.Round( ( DateTimeOffset.UtcNow - started ).TotalSeconds ),
        };
        await File.WriteAllTextAsync( Path.Combine( filled, "long-room.json" ), metadata.ToJsonString( indented ) ).ConfigureAwait( false );

        if ( Directory.Exists( target ) )
        {
            var aside = $"{target}.replaced-{DateTime.UtcNow.ToString( "yyyyMMddHHmmss", CultureInfo.InvariantCulture )}";
            Directory.Move( target, aside );
            Console.WriteLine( $"bench/long-room-seed: the previous {options.Name} is now {aside}" );
        }

        Directory.Move( filled, target );
        Directory.Delete( work, recursive: true );
        Console.WriteLine( $"bench/long-room-seed: {target}: {inRoom:N0} messages in room {room}, messages page before {before}" );

        return 0;
    }

    private static string WriterImage( string writer ) => writer switch
    {
        "reference" => Environment.GetEnvironmentVariable( "REFERENCE_IMAGE" ) ?? "campfire-reference:app",
        "rust" => Environment.GetEnvironmentVariable( "RUST_IMAGE" ) ?? "campfire-rust:app",
        "rust-v0.1.1" => Environment.GetEnvironmentVariable( "RUST_V011_IMAGE" ) ?? "campfire-rust:v0.1.1",
        "dotnet-aot" => Environment.GetEnvironmentVariable( "DOTNET_AOT_IMAGE" ) ?? "campfire-dotnet:aot",
        "dotnet-jit" => Environment.GetEnvironmentVariable( "DOTNET_JIT_IMAGE" ) ?? "campfire-dotnet:jit",
        _ => Environment.GetEnvironmentVariable( "DOTNET_IMAGE" ) ?? "campfire-dotnet:app",
    };

    /// <summary>Runs a query through the sqlite3 shell and reads its last line of output as a whole number.</summary>
    private static async Task<long> SqlNumberAsync( string database, string sql, bool readOnly = false )
    {
        var output = await SqlAsync( database, sql, readOnly ).ConfigureAwait( false );

        return long.Parse( output, CultureInfo.InvariantCulture );
    }

    /// <summary>Runs SQL through the sqlite3 shell and returns its last line of output.</summary>
    private static async Task<string> SqlAsync( string database, string sql, bool readOnly = false )
    {
        List<string> arguments = readOnly ? ["-readonly", database, sql] : [database, sql];
        var output = await Commands.RequireAsync( "sqlite3", arguments ).ConfigureAwait( false );

        return output.Split( '\n' ).Last( ).Trim( );
    }
}

internal sealed record SeedOptions( long Messages, string Writer, string Source, string Name, string RoomLabel, int Connections, bool Force )
{
    public static SeedOptions? Parse( string[] args )
    {
        long messages = 235_767;
        var writer = "reference";
        var source = "default";
        var name = "long-room";
        var roomLabel = "rooms.watercooler";
        var connections = 16;
        var force = false;
        var reader = new ArgumentReader( args );
        while ( reader.MoveNext( ) )
        {
            switch ( reader.Current )
            {
                case "--messages" when reader.TryTakePositive( out long count ):
                    messages = count;
                    break;
                case "--writer" when reader.TryTakeValue( out var value ):
                    writer = value;
                    break;
                case "--source" when reader.TryTakeValue( out var value ):
                    source = value;
                    break;
                case "--name" when reader.TryTakeValue( out var value ):
                    name = value;
                    break;
                case "--room-label" when reader.TryTakeValue( out var value ):
                    roomLabel = value;
                    break;
                case "--conc" when reader.TryTakePositive( out int concurrency ):
                    connections = concurrency;
                    break;
                case "--force":
                    force = true;
                    break;
                default:
                    Console.Error.WriteLine( $"bench/long-room-seed: unknown option {reader.Current}" );
                    return null;
            }
        }

        if ( writer.StartsWith( "dotnet", StringComparison.Ordinal ) && Environment.GetEnvironmentVariable( "DOTNET_NATIVE_SECURITY" ) != "0" )
        {
            Console.Error.WriteLine( "bench/long-room-seed: native .NET writers are not supported for cross-engine seeds; "
                + "use reference or a prepared legacy writer with DOTNET_NATIVE_SECURITY=0." );
            return null;
        }

        return new SeedOptions( messages, writer, source, name, roomLabel, connections, force );
    }
}
