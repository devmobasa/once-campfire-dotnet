#!/usr/bin/env bash
# Run the candidate app for the parity harness. Same interface as parity/bin/reference.
#
#   parity/bin/candidate build                      build campfire-dotnet:app (/Dockerfile) and the
#                                                   campfire-candidate parity image on top of it
#                                                   (PARITY_CANDIDATE_APP_IMAGE, _APP_TARGET, _IMAGE,
#                                                   _CLOCK, _SKIP_APP_BUILD: see build() below)
#   parity/bin/candidate up   [--seed NAME] [--port N] [--time ISO8601 [--freeze]] [-e K=V]
#   parity/bin/candidate down [--port N | --all [--everyone]]
#   parity/bin/candidate logs [--port N] [-f]
#   parity/bin/candidate ps   [--everyone]
#   parity/bin/candidate reset --port N [--app reference|candidate] [--seed NAME] [--time ISO8601]
#   parity/bin/candidate compare [--seed NAME] [--ports REF,CAND] [--isolated N] [--time ISO8601] [OPTIONS]
#
# `up` starts an instance on a fresh copy of parity/.seed/NAME (default: default) listening on
# 127.0.0.1:N (default 3200), with the reference's environment (parity/.env.reference), CPU cap
# (PARITY_CPUS, default 2) and storage layout (/rails/storage/{db,files}). --time starts the server
# clock at that instant and lets it tick (FAKETIME="@T"); with --freeze it stays there (FAKETIME
# frozen, and CAMPFIRE_FROZEN_TIME for the app's own clock). PARITY PATCH: in the default `app`
# clock mode the app reads both itself (a .NET TimeProvider, HTTP Date on the real clock); in
# `faketime` mode (the Rust port) the entrypoint preloads libfaketime, as for the reference.
#
# `reset` starts a fresh instance on port N from the seed with a frozen clock: a reference with
# `--app reference` (or `expected`), a candidate otherwise. It's the --reset-host hook for
# comparisons that include mutating states, which get isolated servers on ports P + 1000 * k:
#   parity/bin/compare --expected http://127.0.0.1:3100 --actual http://127.0.0.1:3200 \
#     --reset-host "parity/bin/candidate reset --app {target} --port {port} --seed default --time 2026-03-02T16:00:00Z"
# ({target} is the target's name: `expected`/`actual` unless --expected-name/--actual-name say
# otherwise, so name the reference `reference` or `expected`.)
#
# `compare` does all of that: a reference on REF (default 4111) and a candidate on CAND (default
# 4112), both with their clocks frozen at the seed's instant (as self-parity runs its servers:
# anything a server derives from its clock, such as transfer link expiries and their QR codes, is
# then the same on both), parity/bin/compare between them (reference = expected, candidate =
# actual) with that reset hook and --isolated N (default 3) slots, then everything torn down.
# OPTIONS pass through to parity/bin/compare (--only, --engines, --viewports, --schemes,
# --breakpoints, --out (absolute: it resolves inside parity/), --workers, ...).
#
# Instances use PARITY_OWNER as their label, defaulting to the user name.
# `down --all` and `ps` only touch instances with that label.
# --everyone takes them all. `down --port N` stops that port's instance whoever started it.
#
# Docker only: the Rust app has no native runtime here.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
PARITY=$ROOT/parity
SEEDS=${PARITY_SEED_DIR:-$PARITY/.seed}
INSTANCES=$SEEDS/.candidates
APP_IMAGE=${PARITY_CANDIDATE_APP_IMAGE:-campfire-dotnet:app} # PARITY PATCH: was campfire-rust:app
IMAGE=${PARITY_CANDIDATE_IMAGE:-campfire-candidate}
ENV_FILE=$PARITY/.env.reference
DEFAULT_PORT=3200
OWNER=${PARITY_OWNER:-$(id -un)}

die() { echo "candidate: $*" >&2; exit 1; }
log() { echo "candidate: $*" >&2; }

SEED="" PORT="" TIME="" FREEZE="" FOLLOW="" ALL="" EVERYONE="" APP="" EXTRA_ENV=()

parse_options() {
  REST=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --seed)    SEED=$2; shift 2 ;;
      --port)    PORT=$2; shift 2 ;;
      --time)    TIME=$2; shift 2 ;;
      --freeze)  FREEZE=1; shift ;;
      -e)        EXTRA_ENV+=("$2"); shift 2 ;;
      -f|--follow) FOLLOW=1; shift ;;
      --all)     ALL=1; shift ;;
      --everyone) EVERYONE=1; shift ;;
      --app)     APP=$2; shift 2 ;;
      --)        shift; REST+=("$@"); break ;;
      *)         REST+=("$@"); break ;;
    esac
  done
}

# Same spec as parity/bin/reference: "@T" ticks from T, "T" is frozen at T.
faketime_spec() {
  [ -n "$TIME" ] || return 0
  local t
  t=$(date -u -d "$TIME" '+%Y-%m-%d %H:%M:%S') || die "can't parse --time $TIME"
  if [ -n "$FREEZE" ]; then echo "$t"; else echo "@$t"; fi
}

copy_seed_into() {
  local seed=$1 dir=$2
  mkdir -p "$dir/db" "$dir/storage"
  [ -f "$SEEDS/$seed/db/production.sqlite3" ] || die "seed '$seed' isn't built: parity/bin/seed build $seed"
  cp -a --reflink=auto "$SEEDS/$seed/db/." "$dir/db/"
  cp -a --reflink=auto "$SEEDS/$seed/storage/." "$dir/storage/"
  if [ -d "$SEEDS/$seed/keys" ]; then
    mkdir -p "$dir/keys"; cp -a --reflink=auto "$SEEDS/$seed/keys/." "$dir/keys/"
  fi
}

container() { echo "campfire-candidate-$1"; }
instance_dir() { echo "$INSTANCES/$1"; }
alive() { [ "$(docker inspect -f '{{.State.Running}}' "$(container "$1")" 2>/dev/null)" = "true" ]; }

wait_until_up() {
  local port=$1
  for _ in $(seq 1 240); do
    curl -fsS -o /dev/null "http://127.0.0.1:$port/up" 2>/dev/null && return 0
    alive "$port" || { docker logs "$(container "$port")" 2>&1 | tail -n 40 >&2; die "instance on port $port exited during boot"; }
    sleep 0.25
  done
  docker logs "$(container "$port")" 2>&1 | tail -n 40 >&2
  die "instance on port $port didn't come up within 60s"
}

env_args() {
  local spec; spec=$(faketime_spec)
  printf '%s\n' --env-file "$ENV_FILE"
  if [ -n "$spec" ]; then printf '%s\n' -e "FAKETIME=$spec"; fi
  if [ -n "$FREEZE" ] && [ -n "$TIME" ]; then
    printf '%s\n' -e "CAMPFIRE_FROZEN_TIME=$(date -u -d "$TIME" '+%Y-%m-%dT%H:%M:%SZ')"
  fi
  local e; for e in "${EXTRA_ENV[@]+"${EXTRA_ENV[@]}"}"; do printf '%s\n' -e "$e"; done
}

up() {
  local port=$1 seed=$2 dir; dir=$(instance_dir "$port")
  docker rm -f "$(container "$port")" >/dev/null 2>&1 || true
  rm -rf "$dir"; copy_seed_into "$seed" "$dir"
  mkdir -p "$dir/keys"
  local args=(); mapfile -t args < <(env_args)
  if [ "${PARITY_CANDIDATE_NATIVE_SECURITY:-1}" = 1 ]; then
    sqlite3 "$dir/db/production.sqlite3" "INSERT OR REPLACE INTO ar_internal_metadata(key,value,created_at,updated_at) VALUES ('campfire_synthetic_fixture','1',datetime('now'),datetime('now'))" || return 1
    docker run --rm --user "$(id -u):$(id -g)" "${args[@]}" \
      -e CAMPFIRE_SYNTHETIC_FIXTURE=1 -e CAMPFIRE_SYNTHETIC_PASSWORD=secret123456 \
      -e CAMPFIRE_SYNTHETIC_LABELS_PATH=/rails/synthetic-labels.json \
      -v "$SEEDS/$seed/labels.json:/rails/synthetic-labels.json:ro" \
      -v "$dir/db:/rails/storage/db" -v "$dir/storage:/rails/storage/files" -v "$dir/keys:/rails/storage/keys" \
      "$IMAGE" /usr/local/bin/campfire prepare-fixture >&2 || return 1
  fi
  # Labelled parity.candidate.port (not parity.port) so `reference down --all` leaves it alone.
  docker run -d --name "$(container "$port")" \
    --label parity.seed="$seed" --label parity.candidate.port="$port" --label parity.owner="$OWNER" \
    --cpus "${PARITY_CPUS:-2}" \
    --user "$(id -u):$(id -g)" \
    -p "127.0.0.1:$port:80" \
    "${args[@]}" \
    -v "$dir/db:/rails/storage/db" -v "$dir/storage:/rails/storage/files" -v "$dir/keys:/rails/storage/keys" \
    "$IMAGE" >/dev/null
  wait_until_up "$port"
}

down() {
  docker rm -f "$(container "$1")" >/dev/null 2>&1 || true
  rm -rf "$(instance_dir "$1")"
}

# The caller's instances (every instance with --everyone).
ports() {
  local owner=(); [ -n "$EVERYONE" ] || owner=(--filter "label=parity.owner=$OWNER")
  docker ps -a --filter label=parity.candidate.port "${owner[@]}" --format '{{.Label "parity.candidate.port"}}'
}

# PARITY PATCH: PARITY_CANDIDATE_SKIP_APP_BUILD=1 layers the parity image on an existing
# $APP_IMAGE (for example the Rust port built from its own checkout), and PARITY_CANDIDATE_CLOCK
# picks the clock mode baked into it: app (default; the .NET app reads FAKETIME and
# CAMPFIRE_FROZEN_TIME itself) or faketime (libfaketime preloaded, as for the Rust port).
# PARITY PATCH: PARITY_CANDIDATE_APP_TARGET builds that stage of /Dockerfile: its variants are `aot`
# (the default, its last stage) and `jit` (docs/native-aot.md). Give each its own
# PARITY_CANDIDATE_APP_IMAGE and PARITY_CANDIDATE_IMAGE.
build() {
  if [ -z "${PARITY_CANDIDATE_SKIP_APP_BUILD:-}" ]; then
    local target=()
    if [ -n "${PARITY_CANDIDATE_APP_TARGET:-}" ]; then target=(--target "$PARITY_CANDIDATE_APP_TARGET"); fi
    log "building $APP_IMAGE from /Dockerfile${PARITY_CANDIDATE_APP_TARGET:+ (target $PARITY_CANDIDATE_APP_TARGET)}"
    docker build -t "$APP_IMAGE" -f "$ROOT/Dockerfile" "${target[@]+"${target[@]}"}" \
      --build-arg APP_VERSION=parity --build-arg GIT_REVISION="$(git -C "$ROOT/reference" rev-parse HEAD)" \
      "$ROOT"
  else
    docker image inspect "$APP_IMAGE" >/dev/null 2>&1 || die "no image $APP_IMAGE to layer on"
  fi
  log "building $IMAGE from parity/docker/candidate/Dockerfile (clock: ${PARITY_CANDIDATE_CLOCK:-app})"
  docker build -t "$IMAGE" --build-arg BASE_IMAGE="$APP_IMAGE" --build-arg CLOCK="${PARITY_CANDIDATE_CLOCK:-app}" \
    "$PARITY/docker/candidate"
}

seed_clock() {
  local labels=$SEEDS/$1/labels.json
  [ -f "$labels" ] || die "no seed $1 at $labels; run parity/bin/seed build $1"
  python3 -c 'import json,sys; l=json.load(open(sys.argv[1])); print(l.get("clock.now") or (l.get("clock") or {}).get("now") or "")' "$labels"
}

# Start a fresh instance on PORT from the seed, frozen at TIME: a candidate, or a reference with
# --app reference (the capture engine passes its target name, {target}). Without --app, whichever
# app already owns the port.
reset() {
  local port=${PORT:?reset needs --port} seed=${SEED:-default}
  local time=${TIME:-$(seed_clock "$seed")} app=${APP:-}
  if [ -z "$app" ]; then
    if docker inspect "campfire-reference-$port" >/dev/null 2>&1; then app=reference; else app=candidate; fi
  fi
  case "$app" in
    reference|expected)
      "$PARITY/bin/reference" down --port "$port" >/dev/null
      "$PARITY/bin/reference" up --seed "$seed" --port "$port" --time "$time" --freeze >/dev/null ;;
    *)
      TIME=$time FREEZE=1 up "$port" "$seed" ;;
  esac
}

compare() {
  local ports=4111,4112 isolated=3 rest=() seed=${SEED:-default} time=${TIME:-}
  while [ $# -gt 0 ]; do
    case "$1" in
      --ports) ports=$2; shift 2 ;;
      --isolated) isolated=$2; shift 2 ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  [ -n "$time" ] || time=$(seed_clock "$seed")
  local ref_port cand_port; IFS=, read -r ref_port cand_port <<<"$ports"
  # Mutating states run on isolated slots k = 1..N at P + 1000 * k (parity/capture/run.ts).
  COMPARE_REF_PORTS=("$ref_port") COMPARE_CAND_PORTS=("$cand_port")
  local k; for k in $(seq 1 "$isolated"); do
    COMPARE_REF_PORTS+=($((ref_port + 1000 * k))); COMPARE_CAND_PORTS+=($((cand_port + 1000 * k)))
  done
  trap compare_teardown EXIT INT TERM
  log "reference :$ref_port vs candidate :$cand_port (seed $seed, clock frozen at $time)"
  "$PARITY/bin/reference" up --seed "$seed" --port "$ref_port" --time "$time" --freeze >/dev/null &
  local ref_pid=$!
  TIME=$time FREEZE=1 up "$cand_port" "$seed"
  wait "$ref_pid" || die "reference didn't come up"
  local status=0
  local profile_args=()
  if [ "${PARITY_CANDIDATE_NATIVE_SECURITY:-1}" = 1 ]; then profile_args=(--actual-native-target); fi
  "$PARITY/bin/compare" --seed "$seed" --time "$time" \
    --expected "http://127.0.0.1:$ref_port" --actual "http://127.0.0.1:$cand_port" \
    --expected-name reference --actual-name candidate --isolated "$isolated" \
    --reset-host "'$PARITY/bin/candidate' reset --app {target} --port {port} --seed '$seed' --time '$time'" \
    "${profile_args[@]}" "${rest[@]+"${rest[@]}"}" &
  # In the background so an interrupt runs compare_teardown at once (which stops it first).
  COMPARE_PID=$!
  wait "$COMPARE_PID" || status=$?
  COMPARE_PID=""
  return $status
}

compare_teardown() {
  local p
  if [ -n "${COMPARE_PID:-}" ]; then kill -TERM "$COMPARE_PID" 2>/dev/null || true; wait "$COMPARE_PID" 2>/dev/null || true; fi
  for p in "${COMPARE_REF_PORTS[@]}"; do "$PARITY/bin/reference" down --port "$p" >/dev/null 2>&1 || true; done
  for p in "${COMPARE_CAND_PORTS[@]}"; do down "$p"; done
}

cmd=${1:-help}; shift || true
if [ "$cmd" = compare ]; then
  # compare's own options go through untouched, except --seed/--time which it shares.
  pass=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --seed) SEED=$2; shift 2 ;;
      --time) TIME=$2; shift 2 ;;
      *) pass+=("$1"); shift ;;
    esac
  done
  compare "${pass[@]+"${pass[@]}"}"
  exit $?
fi
parse_options "$@"
set -- "${REST[@]+"${REST[@]}"}"

case "$cmd" in
  build)
    build ;;
  up)
    port=${PORT:-$DEFAULT_PORT} seed=${SEED:-default}
    up "$port" "$seed"
    echo "http://127.0.0.1:$port  (seed: $seed, candidate${TIME:+, time: $(faketime_spec)})" ;;
  down)
    if [ -n "$ALL" ]; then
      for p in $(ports); do down "$p"; done
    else
      down "${PORT:-$DEFAULT_PORT}"
    fi ;;
  logs)
    if [ -n "$FOLLOW" ]; then docker logs -f "$(container "${PORT:-$DEFAULT_PORT}")"
    else docker logs "$(container "${PORT:-$DEFAULT_PORT}")"; fi ;;
  ps)
    for p in $(ports); do
      if alive "$p"; then echo "$p up"; else echo "$p down"; fi
    done ;;
  reset)
    reset ;;
  help|-h|--help)
    sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//' ;;
  *)
    die "unknown command $cmd (try help)" ;;
esac
